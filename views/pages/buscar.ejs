<%- include('../partials/header') %>
<%- include('../partials/page-hero', { heading: 'Buscar en el sitio' }) %>
    <section class="section">
      <div class="container narrow">
        <form class="form search-form" action="/buscar" method="get" role="search">
          <div><label for="q-page">Término de búsqueda</label><input id="q-page" name="q" type="search" maxlength="100" value="<%= q %>"></div>
          <div><button class="btn btn--primary" type="submit">Buscar</button></div>
        </form>
        <div aria-live="polite">
          <% const total = secciones.length + paginas.length + noticias.length + documentos.length; %>
          <% if (!q) { %>
            <p>Escriba un término en el buscador.</p>
          <% } else if (q.length < 2) { %>
            <p>Escriba al menos 2 caracteres.</p>
          <% } else if (!total) { %>
            <p>No se encontraron resultados para <strong><%= q %></strong>. Intente con otras palabras o visite <a href="/tramites">Trámites y servicios</a>.</p>
          <% } else { %>
            <p><%= total %> resultado(s) para <strong><%= q %></strong>:</p>
            <% if (secciones.length) { %><h2 class="h3">Secciones</h2><ul class="results"><% secciones.forEach(function (p) { %><li><a href="<%= p.u %>"><%= p.t %></a></li><% }) %></ul><% } %>
            <% if (paginas.length) { %><h2 class="h3">Páginas</h2><ul class="results"><% paginas.forEach(function (p) { %><li><a href="/<%= p.slug %>"><%= p.titulo %></a></li><% }) %></ul><% } %>
            <% if (noticias.length) { %><h2 class="h3">Noticias</h2><ul class="results"><% noticias.forEach(function (n) { %><li><a href="/noticias/<%= n.slug %>"><%= n.titulo %></a> <small><%= fecha(n.fechaPublicacion) %></small></li><% }) %></ul><% } %>
            <% if (documentos.length) { %><h2 class="h3">Documentos</h2><ul class="results"><% documentos.forEach(function (d) { %><li><a href="/documentos/<%= d.id %>" target="_blank" rel="noopener"><%= tipos[d.tipo] %> <%= d.numero %> de <%= d.anio %></a> – <%= d.asunto %></li><% }) %></ul><% } %>
          <% } %>
        </div>
      </div>
    </section>
<%- include('../partials/footer') %>
