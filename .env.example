# Variables de entorno del Portal SEM Ibagué. VALORES FICTICIOS: reemplácelos en el servidor.
# Este archivo se versiona; el archivo real (.env o el gestor de secretos) NUNCA se sube a Git.
# Genere los secretos con: npm run generate-keys

NODE_ENV=production
PORT=3000
APP_URL=https://portal.example.gov.co
TRUST_PROXY=1
AUTO_MIGRATE=false

# --- Secretos (obligatorios en producción) ---
SESSION_SECRET=reemplazar-por-un-valor-aleatorio-de-al-menos-48-caracteres
DATA_ENCRYPTION_KEY=cmVlbXBsYXphci1wb3ItMzItYnl0ZXMtYWxlYXRvcmlvcw==

# --- Sesiones ---
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
MFA_ISSUER=SEM Ibagué

# --- Almacenamiento (fuera de la carpeta del código) ---
STORAGE_DIR=/var/lib/semibague
# DB_PATH=/var/lib/semibague/semibague.sqlite
# MEDIA_DIR=/var/lib/semibague/media
# UPLOADS_DIR=/var/lib/semibague/uploads
MAX_IMAGE_MB=8
MAX_AUDIO_MB=20
# Tamaño máximo de una solicitud de carga (todos los archivos juntos)
MAX_UPLOAD_REQUEST_MB=25
# Antimalware (recomendado): ruta absoluta de clamdscan
MALWARE_SCAN_COMMAND=

# --- Correo (invitaciones y recuperación de acceso) ---
SMTP_URL=smtps://usuario-ficticio:clave-ficticia@smtp.example.gov.co:465
MAIL_FROM=Portal SEM Ibagué <no-responder@example.gov.co>

# --- Estadísticas ---
STATS_RETENTION_DAYS=395
# Cabecera de país que entrega el proxy o CDN (p. ej. cf-ipcountry). Vacío = sin país.
STATS_GEO_HEADER=

# --- API ---
# Orígenes exactos autorizados para la API pública de lectura, separados por coma. Vacío = CORS cerrado.
CORS_ORIGINS=
# Pruebas interactivas en Swagger del panel. Mantener en false en producción.
API_DOCS_TRY_IT_OUT=false
