# Variables de entorno del Portal SEM Ibagué (configuración NO secreta). Este archivo se versiona.
#
# SECRETOS: aquí NO van contraseñas ni claves. En producción el portal NO arranca si encuentra un secreto en
# una variable de entorno o en .env. Los secretos los entrega el gestor de secretos (Vault, AWS/Azure/GCP
# Secrets Manager, secretos de Docker/Kubernetes o LoadCredential de systemd) como ARCHIVOS. Ver docs/SECRETOS.md.
#   Crear los archivos iniciales:  npm run secrets -- generar --dir /etc/semibague/secretos
#   Ver su estado (sin valores):    npm run secrets -- estado

NODE_ENV=production
PORT=3000
APP_URL=https://portal.example.gov.co
TRUST_PROXY=1
AUTO_MIGRATE=false
# HOST=127.0.0.1           # en producción escucha solo en localhost (detrás del proxy)
# INSTANCE_ID=app-1        # distinto por instancia si hay varias

# --- PostgreSQL ---
DB_HOST=db.interna.example.gov.co
DB_PORT=5432
DB_NAME=semibague
# Cuenta de la APLICACIÓN (solo SELECT/INSERT/UPDATE/DELETE; sin superusuario).
# Su contraseña es el secreto DB_PASSWORD (archivo); se relee en cada conexión: rotarla no exige reiniciar.
DB_USER=semibague_app
# Cuenta de MIGRACIONES (solo en el paso de despliegue). Contraseña: secreto DB_MIGRATION_PASSWORD.
DB_MIGRATION_USER=semibague_migrator
# TLS: disable | require | verify-full (obligatorio verify-full si la BD está en otro servidor)
DB_SSL=verify-full
DB_SSL_CA_FILE=/etc/semibague/pg-ca.pem
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
DB_SLOW_QUERY_MS=500

# --- Secretos: SOLO la ubicación, nunca el valor ---
# Carpeta donde el gestor monta un archivo por secreto (permisos 0400/0600, propietario el usuario del servicio):
#   SESSION_SECRETS, DATA_ENCRYPTION_KEYS, DB_PASSWORD, DB_MIGRATION_PASSWORD (solo despliegue), SMTP_URL,
#   DB_ADMIN_URL (solo para "npm run secrets -- rotar-bd", nunca en el servicio).
SECRETS_DIR=/etc/semibague/secretos
# O un archivo por secreto: DB_PASSWORD_FILE=/run/secrets/db_password (también con systemd LoadCredential=).
# Política de rotación de la clave de datos (días); el portal avisa al arrancar si se supera.
SECRETS_MAX_AGE_DAYS=90

# --- Sesiones ---
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
MFA_ISSUER=SEM Ibagué

# --- Almacenamiento (fuera de la carpeta del código) ---
STORAGE_DIR=/var/lib/semibague
# MEDIA_DIR=/var/lib/semibague/media
# UPLOADS_DIR=/var/lib/semibague/uploads
MAX_IMAGE_MB=8
MAX_AUDIO_MB=20
# Tamaño máximo de una solicitud de carga (todos los archivos juntos)
MAX_UPLOAD_REQUEST_MB=25
# Antimalware obligatorio para cargar archivos en producción: ruta absoluta de clamdscan.
# Si falta o falla, las cargas responden 503; el resto del portal sigue disponible.
MALWARE_SCAN_COMMAND=

# --- Correo (invitaciones y recuperación de acceso) ---
# La URL de SMTP incluye la contraseña: es el secreto SMTP_URL (archivo). El servidor debe admitir TLS.
MAIL_FROM=Portal SEM Ibagué <no-responder@example.gov.co>

# --- Estadísticas ---
STATS_RETENTION_DAYS=395
# Cabecera de país que entrega el proxy o CDN (p. ej. cf-ipcountry). Vacío = sin país.
STATS_GEO_HEADER=

# --- Caché del contenido público (segundos; 0 = desactivada) ---
PUBLIC_CACHE_TTL_SECONDS=60
PUBLIC_CACHE_MAX_ENTRIES=500
# Estadísticas: escritura por lotes en segundo plano
STATS_FLUSH_INTERVAL_MS=2000
STATS_FLUSH_BATCH_SIZE=200
# Registrar todas las solicitudes (método, ruta, estado, duración); por defecto solo lentas y errores
LOG_REQUESTS=false

# --- API ---
# Orígenes exactos autorizados para la API pública de lectura, separados por coma. Vacío = CORS cerrado.
CORS_ORIGINS=
# Pruebas interactivas en Swagger del panel. Mantener en false en producción.
API_DOCS_TRY_IT_OUT=false
