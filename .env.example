# Copie este archivo como .env en el servidor y complete los valores.
# El archivo .env NUNCA se sube a Git ni se envía al navegador.
# Genere las claves con:  npm run generate-keys

NODE_ENV=production
PORT=3000

# Número de proxies inversos delante de la app (Nginx/Apache = 1)
TRUST_PROXY=1

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres)
SESSION_SECRET=

# Clave AES-256 (32 bytes en base64) para cifrar datos personales de las PQRSD.
# Guarde una copia segura: si se pierde, los datos cifrados no se pueden recuperar.
DATA_ENCRYPTION_KEY=

# Opcional: rutas de almacenamiento (por defecto ./storage)
# DB_PATH=/var/lib/semibague/semibague.sqlite
# UPLOADS_DIR=/var/lib/semibague/uploads
