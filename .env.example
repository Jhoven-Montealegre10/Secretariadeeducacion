# Variables de entorno del Portal SEM Ibagué. VALORES FICTICIOS: reemplácelos en el servidor.
# Este archivo se versiona; el archivo real (.env o el gestor de secretos) NUNCA se sube a Git.
# Genere los secretos con: npm run generate-keys

NODE_ENV=production
PORT=3000
APP_URL=https://portal.example.gov.co
TRUST_PROXY=1
AUTO_MIGRATE=false
# HOST=127.0.0.1           # en producción escucha solo en localhost (detrás del proxy)
# INSTANCE_ID=app-1        # distinto por instancia si hay varias

# --- PostgreSQL ---
DB_HOST=db.interna.example.gov.co
DB_PORT=5432
DB_NAME=semibague
# Cuenta de la APLICACIÓN (solo SELECT/INSERT/UPDATE/DELETE; sin superusuario)
DB_USER=semibague_app
DB_PASSWORD=reemplazar-clave-ficticia-de-la-aplicacion
# Cuenta de MIGRACIONES (solo en el paso de despliegue; no la deje en el entorno del servicio)
DB_MIGRATION_USER=semibague_migrator
DB_MIGRATION_PASSWORD=reemplazar-clave-ficticia-de-migraciones
# TLS: disable | require | verify-full (obligatorio verify-full si la BD está en otro servidor)
DB_SSL=verify-full
DB_SSL_CA_FILE=/etc/semibague/pg-ca.pem
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
DB_SLOW_QUERY_MS=500

# --- Secretos (obligatorios en producción) ---
SESSION_SECRET=reemplazar-por-un-valor-aleatorio-de-al-menos-48-caracteres
DATA_ENCRYPTION_KEY=cmVlbXBsYXphci1wb3ItMzItYnl0ZXMtYWxlYXRvcmlvcw==

# --- Sesiones ---
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
MFA_ISSUER=SEM Ibagué

# --- Almacenamiento (fuera de la carpeta del código) ---
STORAGE_DIR=/var/lib/semibague
# MEDIA_DIR=/var/lib/semibague/media
# UPLOADS_DIR=/var/lib/semibague/uploads
MAX_IMAGE_MB=8
MAX_AUDIO_MB=20
# Tamaño máximo de una solicitud de carga (todos los archivos juntos)
MAX_UPLOAD_REQUEST_MB=25
# Antimalware obligatorio para cargar archivos en producción: ruta absoluta de clamdscan.
# Si falta o falla, las cargas responden 503; el resto del portal sigue disponible.
MALWARE_SCAN_COMMAND=

# --- Correo (invitaciones y recuperación de acceso) ---
SMTP_URL=smtps://usuario-ficticio:clave-ficticia@smtp.example.gov.co:465
MAIL_FROM=Portal SEM Ibagué <no-responder@example.gov.co>

# --- Estadísticas ---
STATS_RETENTION_DAYS=395
# Cabecera de país que entrega el proxy o CDN (p. ej. cf-ipcountry). Vacío = sin país.
STATS_GEO_HEADER=

# --- Caché del contenido público (segundos; 0 = desactivada) ---
PUBLIC_CACHE_TTL_SECONDS=60
PUBLIC_CACHE_MAX_ENTRIES=500
# Estadísticas: escritura por lotes en segundo plano
STATS_FLUSH_INTERVAL_MS=2000
STATS_FLUSH_BATCH_SIZE=200
# Registrar todas las solicitudes (método, ruta, estado, duración); por defecto solo lentas y errores
LOG_REQUESTS=false

# --- API ---
# Orígenes exactos autorizados para la API pública de lectura, separados por coma. Vacío = CORS cerrado.
CORS_ORIGINS=
# Pruebas interactivas en Swagger del panel. Mantener en false en producción.
API_DOCS_TRY_IT_OUT=false
