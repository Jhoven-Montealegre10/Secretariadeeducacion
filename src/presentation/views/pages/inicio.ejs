<%- include('../partials/header') %>
    <section class="hero">
      <div class="container">
        <span class="hero__tag"><%= site.entidad %> · Tolima</span>
        <h1><%= site.nombre %></h1>
        <p>Trabajamos por una educación pública de calidad, incluyente y pertinente para niñas, niños, adolescentes, jóvenes y adultos de Ibagué. Encuentre aquí trámites, servicios e información de la comunidad educativa.</p>
        <div class="hero__actions">
          <a class="btn btn--white" href="/tramites">Ver trámites y servicios</a>
          <a class="btn btn--outline" href="/atencion#pqrsd">Radicar una PQRSD</a>
        </div>
      </div>
    </section>

<% if (slider) { %><div class="hero-slider"><%- include('../partials/slider', { slider }) %></div><% } %>
    <section class="quick" aria-label="Accesos rápidos">
      <div class="container quick__grid">
        <a class="quick__item" href="/tramites#matricula">
          <span class="quick__icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c3 2 9 2 12 0v-5"/></svg></span>
          Matrícula y cupos
        </a>
        <a class="quick__item" href="/tramites#docentes">
          <span class="quick__icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg></span>
          Certificados laborales
        </a>
        <a class="quick__item" href="/tramites#prestaciones">
          <span class="quick__icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="13" rx="2"/><circle cx="12" cy="12.5" r="2.5"/><path d="M6 6V4h12v2"/></svg></span>
          Prestaciones económicas
        </a>
        <a class="quick__item" href="/atencion#pqrsd">
          <span class="quick__icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
          PQRSD
        </a>
        <a class="quick__item" href="/normatividad">
          <span class="quick__icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"/><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5"/></svg></span>
          Circulares
        </a>
        <a class="quick__item" href="/transparencia">
          <span class="quick__icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg></span>
          Transparencia
        </a>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section__head">
          <div>
            <span class="eyebrow">Actualidad</span>
            <h2 class="title-line">Noticias y comunicados</h2>
          </div>
          <a class="btn btn--outline-blue" href="/noticias">Ver todas las noticias</a>
        </div>
        <% if (noticias.length) { %>
        <div class="grid grid--3">
          <% noticias.forEach(function (n) { %><%- include('../partials/noticia-card', { n, imagenes }) %><% }) %>
        </div>
        <% } else { %>
        <p>Aún no hay noticias publicadas.</p>
        <% } %>
      </div>
    </section>

    <section class="section section--alt">
      <div class="container">
        <div class="section__head">
          <div>
            <span class="eyebrow">¿Quién es usted?</span>
            <h2 class="title-line">Servicios según su perfil</h2>
          </div>
        </div>
        <div class="grid grid--4">
          <a class="card service" href="/comunidad#estudiantes"><h3>Estudiantes y familias</h3><p>Matrículas, cupos, traslados, certificados de estudio y programas de bienestar.</p></a>
          <a class="card service" href="/comunidad#docentes"><h3>Docentes y directivos</h3><p>Certificados laborales, novedades de nómina, prestaciones, escalafón y formación.</p></a>
          <a class="card service" href="/tramites#establecimientos"><h3>Establecimientos educativos</h3><p>Licencias de funcionamiento, costos educativos y reportes de información.</p></a>
          <a class="card service" href="/atencion"><h3>Ciudadanía</h3><p>Peticiones, quejas, reclamos, sugerencias, denuncias y acceso a información pública.</p></a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container grid grid--2 items-start">
        <div>
          <span class="eyebrow">En línea</span>
          <h2 class="title-line">Sistemas de información</h2>
          <p>Acceda a las plataformas del sector educativo para realizar trámites sin desplazarse.</p>
          <div class="grid grid--2">
            <div class="card card__body"><h3>PQRSD en línea</h3><p>Radique su solicitud y consulte su estado con el número de radicado.</p><a class="card__link" href="/atencion#pqrsd">Ingresar</a></div>
            <div class="card card__body"><h3>Humano en Línea</h3><p>Certificados laborales, desprendibles de pago y novedades del personal.</p><a class="card__link" href="/tramites#sistemas">Ingresar</a></div>
            <div class="card card__body"><h3>SIMAT</h3><p>Sistema Integrado de Matrícula para instituciones educativas.</p><a class="card__link" href="/tramites#sistemas">Ingresar</a></div>
            <div class="card card__body"><h3>FOMAG</h3><p>Prestaciones sociales, cesantías y salud del magisterio.</p><a class="card__link" href="https://www.fomag.gov.co/" target="_blank" rel="noopener">Ingresar</a></div>
          </div>
        </div>
        <aside class="info-panel" aria-label="Horarios de atención">
          <h3>Horario de atención al público</h3>
          <ul class="info-list">
            <li><div><strong>Secretaría de Educación</strong><%= site.horario.general[0] %><br><%= site.horario.general[1] %></div></li>
            <li><div><strong>Fondo de Prestaciones Económicas</strong><%= site.horario.prestaciones[0] %><br><%= site.horario.prestaciones[1] %></div></li>
            <li><div><strong>Dirección</strong><%= site.direccion %></div></li>
            <li><div><strong>Contacto</strong><a href="tel:<%= site.telefonoLink %>"><%= site.telefono %></a> · <a href="mailto:<%= site.correo %>"><%= site.correo %></a></div></li>
          </ul>
          <p class="mt-16 m-b0"><a class="btn btn--white" href="/contacto">Cómo llegar</a></p>
        </aside>
      </div>
    </section>

    <section class="section section--blue">
      <div class="container">
        <div class="section__head">
          <div>
            <span class="eyebrow">Transparencia</span>
            <h2 class="title-line">Información pública al alcance de todos</h2>
          </div>
        </div>
        <div class="grid grid--3">
          <a class="card card__body" href="/transparencia#planeacion"><h3>Planes y presupuesto</h3><p>Plan de acción, plan de desarrollo sectorial, presupuesto y ejecución.</p></a>
          <a class="card card__body" href="/transparencia#contratacion"><h3>Contratación</h3><p>Procesos contractuales publicados en SECOP y plan anual de adquisiciones.</p></a>
          <a class="card card__body" href="/transparencia#informes"><h3>Informes y rendición de cuentas</h3><p>Informes de gestión, control interno y rendición de cuentas a la ciudadanía.</p></a>
        </div>
      </div>
    </section>
<%- include('../partials/footer') %>
