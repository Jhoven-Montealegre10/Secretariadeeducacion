          <article class="card">
            <div class="card__img"><%= n.categoria %></div>
            <div class="card__body">
              <span class="badge"><%= n.categoria %></span>
              <p class="card__date"><time datetime="<%= n.fecha_publicacion %>"><%= fecha(n.fecha_publicacion) %></time></p>
              <h3><%= n.titulo %></h3>
              <p><%= n.resumen %></p>
              <a class="card__link" href="/noticias/<%= n.slug %>">Leer más<span class="sr-only">: <%= n.titulo %></span></a>
            </div>
          </article>
