<%- include('_header') %>
      <p><a href="/admin/pqrsd">← Volver al listado</a></p>
      <h1>Radicado <%= s.radicado %></h1>
      <div class="grid grid--2 items-start">
        <div class="card card__body">
          <h3>Datos de la solicitud</h3>
          <p>
            <strong>Tipo:</strong> <%= s.tipo %><br>
            <strong>Radicada (UTC):</strong> <%= s.creado_en %><br>
            <strong>Ciudadano:</strong> <%= s.nombre %><br>
            <strong>Documento:</strong> <%= s.tipo_documento %> <%= s.documento %><br>
            <strong>Correo:</strong> <%= s.email %><br>
            <strong>Teléfono:</strong> <%= s.telefono || '—' %>
          </p>
          <h3>Asunto</h3>
          <p><%= s.asunto %></p>
          <h3>Descripción</h3>
          <% parrafos(s.mensaje).forEach(function (p) { %><p><%= p %></p><% }) %>
        </div>
        <form class="form card card__body" method="post" action="/admin/pqrsd/<%= s.id %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <h3>Gestión</h3>
          <div>
            <label for="estado">Estado</label>
            <select id="estado" name="estado"><% estados.forEach(function (e) { %><option <%= s.estado === e ? 'selected' : '' %>><%= e %></option><% }) %></select>
            <% if (errors.estado) { %><p class="field-error"><%= errors.estado %></p><% } %>
          </div>
          <div>
            <label for="respuesta">Respuesta al ciudadano</label>
            <textarea id="respuesta" name="respuesta" rows="10" maxlength="10000"><%= s.respuesta || '' %></textarea>
            <small>El ciudadano la verá al consultar con su radicado y documento.</small>
            <% if (errors.respuesta) { %><p class="field-error"><%= errors.respuesta %></p><% } %>
          </div>
          <div><button class="btn btn--primary" type="submit">Guardar</button></div>
        </form>
      </div>
<%- include('_footer') %>
