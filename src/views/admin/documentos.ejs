<%- include('_header') %>
      <div class="section__head">
        <h1 class="m-0">Documentos y normatividad</h1>
        <a class="btn btn--primary" href="/admin/documentos/nuevo">+ Publicar documento</a>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Tipo</th><th>Número</th><th>Fecha</th><th>Asunto</th><th>Acciones</th></tr></thead>
          <tbody>
            <% documentos.forEach(function (d) { %>
            <tr>
              <td><%= tipos[d.tipo] %></td>
              <td><%= d.numero %> de <%= d.anio %></td>
              <td><%= d.fecha %></td>
              <td><%= d.asunto %></td>
              <td class="actions">
                <a href="/documentos/<%= d.id %>" target="_blank" rel="noopener">Ver PDF</a>
                <form method="post" action="/admin/documentos/<%= d.id %>/eliminar" data-confirm="¿Eliminar este documento?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                  <button class="link-danger" type="submit">Eliminar</button>
                </form>
              </td>
            </tr>
            <% }) %>
            <% if (!documentos.length) { %><tr><td colspan="5">No hay documentos publicados.</td></tr><% } %>
          </tbody>
        </table>
      </div>
<%- include('_footer') %>
