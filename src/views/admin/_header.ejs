<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> | Administración SEM Ibagué</title>
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/styles.css">
</head>
<body class="admin">
  <div class="govco-bar">
    <div class="container">
      <span class="govco-logo"><span class="govco-mark" aria-hidden="true">CO</span> GOV.CO</span>
      <% if (usuario) { %>
      <form method="post" action="/admin/logout" class="govco-bar__tools">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <span class="hide-sm"><%= usuario.nombre %> (<%= usuario.rol %>)</span>
        <a href="/admin/password">Contraseña</a>
        <button type="submit">Cerrar sesión</button>
      </form>
      <% } %>
    </div>
  </div>
  <% if (usuario) { %>
  <nav class="main-nav admin-nav" aria-label="Menú de administración">
    <div class="container">
      <ul>
        <li><a href="/admin">Panel</a></li>
        <li><a href="/admin/noticias">Noticias</a></li>
        <li><a href="/admin/documentos">Documentos</a></li>
        <% if (usuario.rol === 'admin') { %><li><a href="/admin/pqrsd">PQRSD</a></li><% } %>
        <li><a href="/" target="_blank" rel="noopener">Ver sitio ↗</a></li>
      </ul>
    </div>
  </nav>
  <% } %>
  <main id="contenido" class="section">
    <div class="container">
