<%- include('_header') %>
      <div class="narrow-sm">
        <h1>Cambiar contraseña</h1>
        <% if (ok) { %><div class="notice notice--blue" role="status">Contraseña actualizada correctamente.</div><% } %>
        <form class="form card card__body" method="post" action="/admin/password">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <div><label for="actual">Contraseña actual</label><input id="actual" name="actual" type="password" required autocomplete="current-password"><% if (errors.actual) { %><p class="field-error"><%= errors.actual %></p><% } %></div>
          <div><label for="nueva">Nueva contraseña</label><input id="nueva" name="nueva" type="password" required minlength="12" autocomplete="new-password"><small>Mínimo 12 caracteres, con mayúsculas, minúsculas y números.</small><% if (errors.nueva) { %><p class="field-error"><%= errors.nueva %></p><% } %></div>
          <div><label for="confirmar">Confirmar nueva contraseña</label><input id="confirmar" name="confirmar" type="password" required autocomplete="new-password"><% if (errors.confirmar) { %><p class="field-error"><%= errors.confirmar %></p><% } %></div>
          <div><button class="btn btn--primary" type="submit">Actualizar</button></div>
        </form>
      </div>
<%- include('_footer') %>
