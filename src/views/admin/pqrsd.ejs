<%- include('_header') %>
      <h1>PQRSD recibidas</h1>
      <form class="filter-box form" method="get" action="/admin/pqrsd">
        <div>
          <label for="estado">Filtrar por estado</label>
          <select id="estado" name="estado" data-autosubmit>
            <option value="">Todos</option>
            <% estados.forEach(function (e) { %><option <%= estado === e ? 'selected' : '' %>><%= e %></option><% }) %>
          </select>
        </div>
      </form>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Radicado</th><th>Fecha (UTC)</th><th>Tipo</th><th>Ciudadano</th><th>Asunto</th><th>Estado</th></tr></thead>
          <tbody>
            <% solicitudes.forEach(function (s) { %>
            <tr>
              <td><a href="/admin/pqrsd/<%= s.id %>"><%= s.radicado %></a></td>
              <td><%= s.creado_en %></td>
              <td><%= s.tipo %></td>
              <td><%= s.nombre %></td>
              <td><%= s.asunto %></td>
              <td><span class="badge"><%= s.estado %></span></td>
            </tr>
            <% }) %>
            <% if (!solicitudes.length) { %><tr><td colspan="6">No hay solicitudes.</td></tr><% } %>
          </tbody>
        </table>
      </div>
<%- include('_footer') %>
