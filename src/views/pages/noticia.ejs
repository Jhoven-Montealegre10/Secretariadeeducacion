<%- include('../partials/header') %>
<%- include('../partials/page-hero', { heading: noticia.titulo, parent: ['Noticias', '/noticias'], intro: noticia.resumen }) %>
    <section class="section">
      <div class="container article">
        <p class="card__date"><span class="badge"><%= noticia.categoria %></span> · <time datetime="<%= noticia.fecha_publicacion %>"><%= fecha(noticia.fecha_publicacion) %></time></p>
        <% parrafos(noticia.contenido).forEach(function (p) { %>
        <p><%= p %></p>
        <% }) %>
        <p class="mt-40"><a class="btn btn--outline-blue" href="/noticias">← Volver a noticias</a></p>
      </div>
    </section>
    <% if (otras.length) { %>
    <section class="section section--alt">
      <div class="container">
        <h2 class="title-line">Otras noticias</h2>
        <div class="grid grid--3">
          <% otras.forEach(function (n) { %><%- include('../partials/noticia-card', { n }) %><% }) %>
        </div>
      </div>
    </section>
    <% } %>
<%- include('../partials/footer') %>
