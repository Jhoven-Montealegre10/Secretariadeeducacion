<%- include('../partials/header') %>
    <section class="page-hero">
      <div class="container">
        <ol class="breadcrumb"><li><a href="/">Inicio</a></li><li>Comunidad educativa</li></ol>
        <h1>Comunidad educativa</h1>
        <p>Información y servicios para estudiantes, familias, docentes, directivos e instituciones.</p>
      </div>
    </section>

    <section class="section" id="estudiantes">
      <div class="container">
        <span class="eyebrow">Estudiantes y familias</span>
        <h2 class="title-line">Lo que necesita saber</h2>
        <div class="grid grid--3">
          <div class="card card__body"><h3>Matrícula y cupos</h3><p>Cronograma, requisitos y canales para inscribirse en un colegio oficial.</p><a class="card__link" href="/tramites#matricula">Ver trámite</a></div>
          <div class="card card__body"><h3>Alimentación escolar (PAE)</h3><p>Complemento alimentario para estudiantes de instituciones oficiales.</p><a class="card__link" href="#programas">Más información</a></div>
          <div class="card card__body"><h3>Transporte escolar</h3><p>Apoyo de movilidad para estudiantes, con prioridad en la zona rural.</p><a class="card__link" href="#programas">Más información</a></div>
          <div class="card card__body"><h3>Educación inclusiva</h3><p>Atención a estudiantes con discapacidad, talentos excepcionales y población vulnerable.</p><a class="card__link" href="#programas">Más información</a></div>
          <div class="card card__body"><h3>Educación para adultos</h3><p>Programas de alfabetización y validación de la básica y la media.</p><a class="card__link" href="#programas">Más información</a></div>
          <div class="card card__body"><h3>Pruebas Saber</h3><p>Resultados y preparación para las evaluaciones del ICFES.</p><a class="card__link" href="https://www.icfes.gov.co/" target="_blank" rel="noopener">Ir al ICFES</a></div>
        </div>
      </div>
    </section>

    <section class="section section--alt" id="docentes">
      <div class="container">
        <span class="eyebrow">Docentes y directivos docentes</span>
        <h2 class="title-line">Servicios para el magisterio</h2>
        <div class="grid grid--4">
          <a class="card service" href="/tramites#docentes"><h3>Certificados</h3><p>Laborales, de salarios y de tiempo de servicio.</p></a>
          <a class="card service" href="/tramites#prestaciones"><h3>Prestaciones</h3><p>Cesantías, pensiones y FOMAG.</p></a>
          <a class="card service" href="/tramites#docentes"><h3>Escalafón</h3><p>Ascensos, reubicación y evaluación.</p></a>
          <a class="card service" href="/normatividad#circulares"><h3>Circulares</h3><p>Directrices y comunicados oficiales.</p></a>
        </div>
      </div>
    </section>

    <section class="section" id="programas">
      <div class="container">
        <span class="eyebrow">Proyectos</span>
        <h2 class="title-line">Programas y proyectos</h2>
        <!-- TODO: actualizar con los programas vigentes del Plan de Desarrollo -->
        <div class="grid grid--3">
          <div class="card card__body"><span class="badge">Bienestar</span><h3>Programa de Alimentación Escolar</h3><p>Contribuye al acceso y la permanencia escolar mediante complementos alimentarios.</p></div>
          <div class="card card__body"><span class="badge">Cobertura</span><h3>Transporte escolar</h3><p>Garantiza la movilidad de estudiantes que viven lejos de su institución.</p></div>
          <div class="card card__body"><span class="badge">Calidad</span><h3>Formación docente</h3><p>Actualización pedagógica, bilingüismo y competencias digitales para maestros.</p></div>
          <div class="card card__body"><span class="badge">Calidad</span><h3>Jornada única</h3><p>Más tiempo escolar para fortalecer los aprendizajes.</p></div>
          <div class="card card__body"><span class="badge">Infraestructura</span><h3>Ambientes de aprendizaje</h3><p>Mejoramiento y dotación de sedes educativas urbanas y rurales.</p></div>
          <div class="card card__body"><span class="badge">Convivencia</span><h3>Convivencia escolar</h3><p>Ruta de atención integral y comités de convivencia (Ley 1620 de 2013).</p></div>
        </div>
      </div>
    </section>

    <section class="section section--alt" id="instituciones">
      <div class="container">
        <span class="eyebrow">Directorio</span>
        <h2 class="title-line">Instituciones educativas oficiales</h2>
        <% if (!q) { %><div class="notice">Listado parcial. Completar con el directorio oficial de instituciones y sedes.</div><% } %>
        <form class="filter-box form" action="/comunidad#instituciones" method="get" role="search">
          <div>
            <label for="filtro-ie">Buscar institución</label>
            <input id="filtro-ie" name="q" type="search" maxlength="80" value="<%= q %>" placeholder="Escriba el nombre o la zona" data-filter-table="tabla-ie">
          </div>
        </form>
        <div class="table-wrap">
          <table id="tabla-ie">
            <thead><tr><th>Institución educativa</th><th>Zona</th></tr></thead>
            <tbody>
              <% instituciones.forEach(function (ie) { %>
              <tr><td><%= ie.nombre %></td><td><%= ie.zona %></td></tr>
              <% }) %>
              <% if (!instituciones.length) { %><tr><td colspan="2">No se encontraron instituciones.</td></tr><% } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
<%- include('../partials/footer') %>
