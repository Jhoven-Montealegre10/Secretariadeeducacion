{
  "name": "semibague-portal",
  "version": "4.0.0",
  "private": true,
  "description": "Portal web de la Secretaría de Educación Municipal de Ibagué (MVC, Node.js + Express)",
  "main": "server.js",
  "engines": {
    "node": ">=24.11.0 <25 || >=26.0.0 <27"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "NODE_ENV=development node --disable-warning=ExperimentalWarning --watch server.js",
    "migrate": "node --disable-warning=ExperimentalWarning scripts/migrate.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "create-admin": "node --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "generate-keys": "node scripts/generate-keys.js",
    "openapi:export": "node --disable-warning=ExperimentalWarning scripts/export-openapi.js",
    "openapi:check": "node --disable-warning=ExperimentalWarning scripts/export-openapi.js --check",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,css,json,md}\"",
    "typecheck": "tsc -p jsconfig.json",
    "test": "NODE_ENV=test node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/*.test.js",
    "verify": "npm run lint && npm run typecheck && npm test && npm run openapi:check && npm audit --omit=dev",
    "test:e2e": "node tests/e2e/panel.e2e.js"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "argon2": "0.45.2",
    "ejs": "7.0.2",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "nodemailer": "10.5.0",
    "otpauth": "9.6.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "swagger-ui-dist": "5.34.1",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.3.2",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/multer": "2.0.0",
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/sanitize-html": "2.16.0",
    "@types/supertest": "6.0.3",
    "autocannon": "9.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "minimatch": "11.0.6"
  }
}
