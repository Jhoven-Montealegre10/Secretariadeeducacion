{
  "name": "semibague-portal",
  "version": "4.0.0",
  "private": true,
  "description": "Portal web de la Secretaría de Educación Municipal de Ibagué (TypeScript + NestJS + PostgreSQL)",
  "main": "dist/src/main.js",
  "engines": {
    "node": ">=24.11.0 <25 || >=26.0.0 <27"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "npm run build && NODE_ENV=development node --enable-source-maps dist/src/main.js",
    "migrate": "npm run build && typeorm -d dist/src/infrastructure/database/migration-cli.js migration:run",
    "migrate:status": "npm run build && typeorm -d dist/src/infrastructure/database/migration-cli.js migration:show",
    "migrate:revert": "npm run build && typeorm -d dist/src/infrastructure/database/migration-cli.js migration:revert",
    "migrate:check": "npm run build && typeorm -d dist/src/infrastructure/database/migration-cli.js migration:generate /tmp/semibague-drift --dr --ch",
    "seed": "node dist/scripts/seed.js",
    "create-admin": "node dist/scripts/create-admin.js",
    "generate-keys": "node dist/scripts/generate-keys.js",
    "backup:sqlite": "node dist/scripts/migracion/respaldo-sqlite.js",
    "migrate:from-sqlite": "node dist/scripts/migracion/sqlite-a-postgres.js",
    "openapi:export": "node dist/scripts/export-openapi.js",
    "openapi:check": "node dist/scripts/export-openapi.js --check",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"public/**/*.{js,css}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "tsc -p tsconfig.json && NODE_ENV=test node --enable-source-maps --test dist/test/unit/*.test.js",
    "test:integration": "tsc -p tsconfig.json && NODE_ENV=test node --enable-source-maps --test --test-concurrency=1 dist/test/integration/*.test.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:e2e": "node dist/test/e2e/run-e2e.js",
    "test:load": "node dist/test/load/run-load.js",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm test && npm run openapi:check && npm audit --omit=dev"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/typeorm": "12.0.2",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "argon2": "0.45.2",
    "ejs": "7.0.2",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "nodemailer": "10.5.0",
    "otpauth": "9.6.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "swagger-ui-dist": "5.34.1",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.3.2",
    "@types/autocannon": "7.12.7",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/multer": "2.0.0",
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/sanitize-html": "2.16.0",
    "@types/supertest": "6.0.3",
    "autocannon": "9.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "playwright": "1.63.0",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "minimatch": "11.0.6"
  }
}
