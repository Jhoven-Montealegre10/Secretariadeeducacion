{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/public/noticias": {
      "get": {
        "description": "Excluye borradores y noticias con fecha de publicación futura.\n\n**Acceso:** público.",
        "operationId": "PublicController_listNews",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "default": 1,
              "example": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "default": 9,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "schema": {
              "example": "matrícula",
              "description": "Búsqueda de texto",
              "type": "string",
              "maxLength": 100
            },
            "description": "Búsqueda de texto"
          }
        ],
        "responses": {
          "200": {
            "description": "Noticias",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaNoticiasPublicas"
                }
              }
            }
          },
          "422": {
            "description": "Error de validación de los datos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "summary": "Noticias publicadas (más recientes primero)",
        "tags": [
          "Public",
          "Público"
        ],
        "security": []
      }
    },
    "/api/v1/public/noticias/{slug}": {
      "get": {
        "description": "**Acceso:** público.",
        "operationId": "PublicController_getNews",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "maxLength": 90,
              "example": "secretaria"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Noticia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoticiaPublicaRespuesta"
                }
              }
            }
          },
          "404": {
            "description": "El recurso no existe o no es visible para usted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "summary": "Detalle de una noticia publicada",
        "tags": [
          "Public",
          "Público"
        ],
        "security": []
      }
    },
    "/api/v1/public/paginas/{slug}": {
      "get": {
        "description": "**Acceso:** público.",
        "operationId": "PublicController_getPage",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "maxLength": 90,
              "example": "secretaria"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaPublica"
                }
              }
            }
          },
          "404": {
            "description": "El recurso no existe o no es visible para usted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "summary": "Página publicada con sus bloques",
        "tags": [
          "Public",
          "Público"
        ],
        "security": []
      }
    },
    "/api/v1/public/sliders/{ubicacion}": {
      "get": {
        "description": "**Acceso:** público.",
        "operationId": "PublicController_getSlider",
        "parameters": [
          {
            "name": "ubicacion",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "maxLength": 90,
              "example": "inicio"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Slider",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SliderPublico"
                }
              }
            }
          },
          "404": {
            "description": "El recurso no existe o no es visible para usted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "summary": "Slider activo de una ubicación",
        "tags": [
          "Public",
          "Público"
        ],
        "security": []
      }
    },
    "/api/v1/public/documentos": {
      "get": {
        "description": "**Acceso:** público.",
        "operationId": "PublicController_listDocuments",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "default": 1,
              "example": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "default": 20,
              "example": 20,
              "description": "Máximo 100",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "description": "Máximo 100"
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "schema": {
              "example": "matrícula",
              "description": "Búsqueda de texto",
              "type": "string",
              "maxLength": 100
            },
            "description": "Búsqueda de texto"
          },
          {
            "name": "tipo",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "circular",
                "resolucion",
                "decreto",
                "acuerdo"
              ]
            }
          },
          {
            "name": "anio",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1990,
              "maximum": 2100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Documentos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaDocumentos"
                }
              }
            }
          },
          "422": {
            "description": "Error de validación de los datos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "summary": "Normatividad publicada",
        "tags": [
          "Public",
          "Público"
        ],
        "security": []
      }
    },
    "/api/v1/public/instituciones": {
      "get": {
        "description": "**Acceso:** público.",
        "operationId": "PublicController_listInstitutions",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Instituciones",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Instituciones"
                }
              }
            }
          }
        },
        "summary": "Directorio de instituciones educativas oficiales",
        "tags": [
          "Public",
          "Público"
        ],
        "security": []
      }
    }
  },
  "info": {
    "title": "API del Portal de la Secretaría de Educación de Ibagué (pública)",
    "description": "API REST del portal. Se divide en **endpoints públicos** (`/api/v1/public/*`, contenido publicado, sin autenticación) y\n**endpoints privados** (administración: requieren sesión con segundo factor, permiso por módulo/acción y token CSRF).\n\n**Política de versiones:** `v1` es estable. Los cambios compatibles (campos nuevos opcionales, endpoints nuevos) se\nagregan sin cambiar la versión. Un cambio incompatible se publica en `/api/v2`; `v1` se mantiene al menos 6 meses\ny sus respuestas incluyen las cabeceras `Deprecation` y `Sunset`.\n\n**Ediciones concurrentes (1.1):** los recursos editables devuelven `version`. Envíela al guardar; si otra persona\nguardó antes, la API responde `409` con código `EDIT_CONFLICT` y `details.versionActual`. Si no se envía, el último\nguardado prevalece (compatibilidad con clientes anteriores).\n\n**Paginación:** `page` (desde 1) y `pageSize` (máx. 100). **Orden:** `sort=campo` o `sort=-campo` (descendente).\nTodos los ejemplos son ficticios.",
    "version": "1.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Público",
      "description": "Contenido publicado para visitantes e integraciones de solo lectura."
    }
  ],
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "Documento": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "circular",
              "resolucion",
              "decreto",
              "acuerdo"
            ]
          },
          "numero": {
            "type": "string",
            "example": "015"
          },
          "anio": {
            "type": "integer",
            "example": 2026
          },
          "fecha": {
            "type": "string",
            "example": "2026-11-05"
          },
          "asunto": {
            "type": "string",
            "example": "Calendario académico 2027"
          },
          "tamano": {
            "type": "integer"
          },
          "url": {
            "type": "string",
            "example": "/documentos/9"
          }
        },
        "required": [
          "id",
          "tipo",
          "numero",
          "anio",
          "fecha",
          "asunto",
          "tamano",
          "url"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "VALIDATION_ERROR"
              },
              "message": {
                "type": "string",
                "example": "Los datos enviados no son válidos."
              },
              "details": {
                "description": "Lista { campo, mensaje } en errores de validación; datos del conflicto en 409."
              },
              "requestId": {
                "type": "string",
                "example": "6f1c2a9e-3b2d-4c1a-9f0e-7d8c5b4a3e21"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "description": "Formato único de error para toda la API."
      },
      "ImagenPublica": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "/media/3f2a9c0d1e4b5a6c7d8e9f0a1b2c3d4e.jpg"
          },
          "textoAlternativo": {
            "type": "string"
          },
          "ancho": {
            "nullable": true,
            "type": "integer"
          },
          "alto": {
            "nullable": true,
            "type": "integer"
          }
        },
        "required": [
          "url",
          "textoAlternativo",
          "ancho",
          "alto"
        ],
        "additionalProperties": false
      },
      "Instituciones": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nombre": {
                  "type": "string"
                },
                "zona": {
                  "type": "string",
                  "enum": [
                    "Urbana",
                    "Rural"
                  ]
                }
              },
              "required": [
                "nombre",
                "zona"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "ListaDocumentos": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Documento"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginacionMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      "ListaNoticiasPublicas": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NoticiaPublica"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginacionMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      "NoticiaPublica": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "titulo": {
            "type": "string"
          },
          "resumen": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          },
          "fechaPublicacion": {
            "type": "string"
          },
          "imagen": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/ImagenPublica"
              }
            ]
          },
          "url": {
            "type": "string",
            "example": "/noticias/inscripciones-2027"
          }
        },
        "required": [
          "slug",
          "titulo",
          "resumen",
          "categoria",
          "fechaPublicacion",
          "imagen",
          "url"
        ],
        "additionalProperties": false
      },
      "NoticiaPublicaDetalle": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "titulo": {
            "type": "string"
          },
          "resumen": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          },
          "fechaPublicacion": {
            "type": "string"
          },
          "imagen": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/ImagenPublica"
              }
            ]
          },
          "url": {
            "type": "string",
            "example": "/noticias/inscripciones-2027"
          },
          "contenido": {
            "type": "string"
          },
          "fotos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImagenPublica"
            }
          }
        },
        "required": [
          "slug",
          "titulo",
          "resumen",
          "categoria",
          "fechaPublicacion",
          "imagen",
          "url",
          "contenido",
          "fotos"
        ],
        "additionalProperties": false
      },
      "NoticiaPublicaRespuesta": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/NoticiaPublicaDetalle"
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "PaginacionMeta": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "example": 20
          },
          "total": {
            "type": "integer",
            "example": 42
          },
          "totalPages": {
            "type": "integer",
            "example": 3
          }
        },
        "required": [
          "page",
          "pageSize",
          "total",
          "totalPages"
        ],
        "additionalProperties": false
      },
      "PaginaPublica": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "titulo": {
                "type": "string"
              },
              "resumen": {
                "type": "string"
              },
              "bloques": {
                "type": "array",
                "items": {},
                "description": "Bloques (ver esquema Bloque); `medioId` se resuelve en `medios`."
              },
              "medios": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "tipo": {
                      "type": "string",
                      "enum": [
                        "imagen",
                        "audio"
                      ]
                    },
                    "mime": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "textoAlternativo": {
                      "type": "string"
                    },
                    "ancho": {
                      "nullable": true,
                      "type": "integer"
                    },
                    "alto": {
                      "nullable": true,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id",
                    "tipo",
                    "mime",
                    "url",
                    "textoAlternativo",
                    "ancho",
                    "alto"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "slug",
              "titulo",
              "resumen",
              "bloques",
              "medios"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "SliderPublico": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "ubicacion": {
                "type": "string"
              },
              "diapositivas": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "titulo": {
                      "type": "string"
                    },
                    "texto": {
                      "type": "string"
                    },
                    "enlace": {
                      "type": "string"
                    },
                    "textoEnlace": {
                      "type": "string"
                    },
                    "imagen": {
                      "$ref": "#/components/schemas/ImagenPublica"
                    }
                  },
                  "required": [
                    "titulo",
                    "texto",
                    "enlace",
                    "textoEnlace",
                    "imagen"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "ubicacion",
              "diapositivas"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      }
    }
  }
}
